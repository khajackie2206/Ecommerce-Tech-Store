# Copy this file to .env (never commit .env).
# One file configures both docker-compose (SQL Server) and the NestJS API.

# --- API ---
NODE_ENV=development
PORT=3000

# --- SQL Server ---
# Used by the API to connect. When the API runs inside Docker, DB_HOST is overridden to "sqlserver".
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
# Also becomes the SA password of the SQL Server container. Must be strong:
# at least 8 characters with 3 of: uppercase, lowercase, digit, symbol.
# Local development only: never reuse this password anywhere else.
DB_PASSWORD=TechStore@123
# Created automatically by docker-compose on first start
DB_NAME=TechStoreDb
# Tables are created by database/schema.sql (npm run db:reset), so keep this false.
# true = TypeORM alters tables to match entities on startup and may drop columns or data.
DB_SYNCHRONIZE=false

# true = print every SQL query in the API log
DB_LOGGING=false

# --- Auth ---
# Secret used to sign login tokens (JWT). Anyone who knows it can forge tokens:
# use a long random value and never commit the real one.
JWT_SECRET=change-me-to-a-long-random-string
# How long a token stays valid, in seconds (86400 = 1 day)
JWT_EXPIRES_IN=86400
