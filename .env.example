# Copy this file to .env (never commit .env).
# One file configures both docker-compose (SQL Server) and the NestJS API.

# --- API ---
NODE_ENV=development
PORT=3000

# --- SQL Server ---
# Used by the API to connect. When the API runs inside Docker, DB_HOST is overridden to "sqlserver".
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
# Also becomes the SA password of the SQL Server container. Must be strong:
# at least 8 characters with 3 of: uppercase, lowercase, digit, symbol.
# Local development only: never reuse this password anywhere else.
DB_PASSWORD=TechStore@123
# Created automatically by docker-compose on first start
DB_NAME=TechStoreDb
# true = TypeORM creates/alters tables from entities on startup (local learning only)
DB_SYNCHRONIZE=true
